    "    (df['minutes'] >= 1080 ) & (df['minutes'] < 1260 ),\n",
    "    (df['minutes'] >= 1260 )\n",
    "]\n",
    "\"\"\"\n",
    "# Les codes associés (même longueur que nb d'intervalles)\n",
    "Codes  = [1,2,3,4]\n",
    "\n",
    "df['periode_code'] = np.select(conditions, Codes, default=0)  # 0 si < 10\n",
    "\n",
    "df.sample(10)"
